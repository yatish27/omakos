{
  "icon_theme": "Zed (Default)",
  "theme": "GitHub Dark Default",
  "auto_install_extensions": {
    "github-dark-default": true,
    "ruby": true,
    "html": true,
    "elixir": true,
  },
  "project_panel": {
    "dock": "left",
  },
  "buffer_font_family": "Google Sans Code",
  "buffer_font_weight": 300,
  "buffer_font_size": 14,
  "buffer_font_features": {
    "calt": true,
    "liga": true,
    "dlig": true,
  },
  "buffer_line_height": {
    "custom": 1.5,
  },
  "soft_wrap": "editor_width",
  "preferred_line_length": 100,
  "format_on_save": "on",
  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,
  "show_whitespaces": "selection",
  "show_wrap_guides": true,
  "cursor_blink": true,
  "enable_language_server": true,
  "file_types": {
    "Ruby": [
      "Gemfile",
      "Guardfile",
      "Rakefile",
      "*.rake",
      "*.gemspec",
      "*.ru",
      "*.arb",
      "*.jbuilder",
      "*.thor",
      "Thorfile",
      "Fastfile",
      "Podfile",
      "Vagrantfile",
      "Brewfile",
    ],
    "HEEx": ["*.heex", "*.leex"],
  },
  "base_keymap": "VSCode",
  "show_call_status_icon": false,
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "confirm_quit": false,
  "restore_on_startup": "last_workspace",
  "extend_comment_on_newline": true,
  "use_autoclose": true,
  "show_completion_documentation": true,
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/node_modules",
    "**/.next",
    "**/_build",
    "**/deps",
    "**/.elixir_ls",
    "**/tmp",
    "**/dist",
    "**/build",
    "**/coverage",
    "**/.cache",
    "**/vendor/bundle",
    "**/public/packs",
    "**/public/assets",
    "**/.idea",
    "**/*.log",
    "**/.turbo",
    "**/.vercel",
    "**/package-lock.json",
    "**/yarn.lock",
  ],
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": false,
    "show_parameter_hints": false,
    "show_other_hints": true,
    "edit_debounce_ms": 700,
    "scroll_debounce_ms": 50,
  },
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "enabled": true,
      "delay_ms": 600,
    },
  },
  "terminal": {
    "font_size": 14,
    "font_family": "Google Sans Code",
    "line_height": {
      "custom": 1.4,
    },
    "shell": {
      "program": "zsh",
    },
    "copy_on_select": true,
    "dock": "bottom",
    "default_width": 640,
    "default_height": 320,
    "detect_venv": {
      "on": {
        "directories": [".env", "env", ".venv", "venv"],
        "activate_script": "default",
      },
    },
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "disable_ai": true,
  "lsp": {
    "ruby-lsp": {
      "initialization_options": {
        "enabledFeatures": {
          "codeActions": true,
          "diagnostics": false,
          "documentHighlights": true,
          "documentLink": true,
          "documentSymbols": true,
          "foldingRanges": true,
          "formatting": false,
          "hover": true,
          "inlayHint": false,
          "onTypeFormatting": true,
          "selectionRanges": true,
          "semanticHighlighting": true,
          "completion": true,
          "codeLens": false,
          "debugging": true,
        },
      },
    },
    "herb": {
      "initialization_options": {
        "formatter": {
          "enabled": true,
        },
      },
    },
    "typescript-language-server": {
      "initialization_options": {
        "preferences": {
          "includeInlayParameterNameHints": "all",
          "includeInlayFunctionParameterTypeHints": true,
          "includeInlayVariableTypeHints": true,
          "includeInlayPropertyDeclarationTypeHints": true,
          "includeInlayFunctionLikeReturnTypeHints": true,
          "includeInlayEnumMemberValueHints": true,
          "importModuleSpecifierPreference": "shortest",
          "quotePreference": "single",
        },
      },
    },
    "tailwindcss-language-server": {
      "settings": {
        "includeLanguages": {
          "erb": "html",
          "eex": "html",
          "heex": "html",
        },
        "experimental": {
          "classRegex": [["class[:]\\s*\"([^\"]*)\"", "([a-zA-Z0-9\\s\\-:]+)"]],
        },
      },
    },
  },
  "languages": {
    "Ruby": {
      "tab_size": 2,
      "hard_tabs": false,
      "format_on_save": "on",
      "formatter": [
        {
          "language_server": {
            "name": "rubocop",
          },
        },
      ],
      "language_servers": ["ruby-lsp", "rubocop"],
      "inlay_hints": {
        "enabled": false,
      },
    },
    "JavaScript": {
      "language_servers": ["typescript-language-server", "eslint", "tailwindcss-language-server"],
      "tab_size": 2,
      "hard_tabs": false,
      "format_on_save": "on",
      "formatter": "prettier",
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
    },
    "TypeScript": {
      "language_servers": ["typescript-language-server", "eslint", "tailwindcss-language-server"],
      "tab_size": 2,
      "hard_tabs": false,
      "format_on_save": "on",
      "formatter": "prettier",
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
    },
    "TSX": {
      "language_servers": ["typescript-language-server", "eslint", "tailwindcss-language-server"],
      "tab_size": 2,
      "hard_tabs": false,
      "format_on_save": "on",
      "formatter": "prettier",
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
    },
    "ERB": {
      "tab_size": 2,
      "hard_tabs": false,
      "format_on_save": "on",
      "language_servers": ["ruby-lsp", "tailwindcss-language-server"],
    },
    "HTML+ERB": {
      "format_on_save": "on",
      "formatter": [
        {
          "language_server": {
            "name": "herb",
          },
        },
      ],
      "language_servers": ["herb", "ruby-lsp", "tailwindcss-language-server"],
    },
    "HTML": {
      "language_servers": ["vscode-html-language-server", "tailwindcss-language-server"],
    },
    "CSS": {
      "language_servers": ["vscode-css-language-server", "tailwindcss-language-server"],
    },
    "Elixir": {
      "language_servers": ["elixir-ls"],
    },
    "EEx": {
      "language_servers": ["elixir-ls", "tailwindcss-language-server"],
    },
    "HEEx": {
      "language_servers": ["elixir-ls", "tailwindcss-language-server"],
    },
  },
}
